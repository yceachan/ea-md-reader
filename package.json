{
  "name": "emd",
  "version": "0.1.0",
  "description": "Read-only Markdown and self-contained HTML reader with the ea-kb reading style",
  "author": "yceachan",
  "license": "MIT",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "node scripts/start.mjs",
    "check": "tsc --noEmit",
    "build": "npm run build:icons && npm run build:native && npm run build:renderer",
    "build:renderer": "vite build",
    "build:native": "node scripts/build-native.mjs",
    "build:icons": "node scripts/render-icons.mjs",
    "test": "npm run test:node && npm run test:ui",
    "test:node": "node --test tests/files.test.cjs tests/platforms.test.mjs tests/mac-platform.test.mjs tests/windows-platform.test.mjs tests/windows-editor.test.cjs tests/windows-startup.test.cjs tests/commands.test.cjs tests/runtime-platforms.test.cjs tests/settings.test.cjs tests/editor-sessions.test.cjs tests/startup.test.cjs tests/devtools.test.cjs tests/electron-fixture.test.cjs tests/scripts.test.mjs",
    "test:ui": "node scripts/test-ui.mjs",
    "test:packaged": "node scripts/test-ui.mjs --packaged",
    "pack": "node scripts/pack.mjs",
    "dist": "node scripts/pack.mjs --dist",
    "install:local": "node scripts/install.mjs",
    "uninstall:local": "node scripts/install.mjs --uninstall"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "dompurify": "^3.2.4",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "katex": "^0.18.0",
    "marked": "^18.0.14",
    "marked-katex-extension": "^5.1.13",
    "medium-zoom": "^1.1.0",
    "mermaid": "^11.16.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "shiki": "^4.5.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  },
  "build": {
    "appId": "io.github.yceachan.emd",
    "productName": "emd",
    "executableName": "emd",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/emd.svg",
      "assets/emd.png",
      "LICENSE",
      "package.json"
    ],
    "artifactName": "emd-${version}-${os}-${arch}.${ext}"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "allowScripts": {
    "electron-winstaller": true,
    "esbuild": true
  },
  "dependencies": {
    "smol-toml": "1.9.0"
  }
}
